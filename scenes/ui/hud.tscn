[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;

// Edge-only red wash for hit feedback. `strength` is driven by hud.gd and fades back to 0 after each hit.
uniform vec4 tint : source_color = vec4(0.55, 0.03, 0.02, 1.0);
uniform float inner = 0.42;
uniform float outer = 1.0;
uniform float strength = 0.0;

void fragment() {
	float d = length(UV - vec2(0.5)) * 1.41421;
	float a = smoothstep(inner, outer, d);
	COLOR = vec4(tint.rgb, a * tint.a * strength);
}
"

[sub_resource type="ShaderMaterial" id="Mat_vignette"]
shader = SubResource("Shader_vignette")
shader_parameter/tint = Color(0.55, 0.03, 0.02, 1)
shader_parameter/inner = 0.42
shader_parameter/outer = 1.0
shader_parameter/strength = 0.0

